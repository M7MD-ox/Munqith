<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="8.0.100" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="publish\**" />
    <Compile Remove="publish_tiny\**" />
    <Compile Remove="Releases\**" />
    <Content Remove="publish\**" />
    <Content Remove="publish_tiny\**" />
    <Content Remove="Releases\**" />
    <EmbeddedResource Remove="publish\**" />
    <EmbeddedResource Remove="publish_tiny\**" />
    <EmbeddedResource Remove="Releases\**" />
    <None Remove="publish\**" />
    <None Remove="publish_tiny\**" />
    <None Remove="Releases\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>