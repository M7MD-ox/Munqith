@using Microsoft.AspNetCore.Components.Web
@using Munqith.Core
@using Munqith.Models
@using Munqith.Services
@implements IDisposable
@inject ISettingsService SettingsService
@inject IStatsService StatsService
@inject ILayoutConverter LayoutConverter
@inject ISmartDetector SmartDetector
@inject IStartupService StartupService
@inject Munqith.UI.TrayApplicationContext TrayContext

<div class="munqith-container @(IsDarkMode ? "dark-theme" : "") @(IsArabic ? "rtl-mode" : "")">
    
    <!-- Top Header -->
    <header class="app-header">
        <div class="brand-section">
            <img src="Resources/app.ico" alt="Munqith Logo" class="brand-logo-img" onerror="this.style.display='none'" />
            <h1 class="serif-heading brand-title">
                @(IsArabic ? "مُنقِذ Munqith" : "Munqith")
            </h1>
        </div>

        <div class="header-actions">
            <button class="claude-btn-secondary" @onclick="ToggleTheme">
                <svg class="svg-icon" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="5"></circle>
                    <line x1="12" y1="1" x2="12" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="23"></line>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                    <line x1="1" y1="12" x2="3" y2="12"></line>
                    <line x1="21" y1="12" x2="23" y2="12"></line>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                </svg>
                @(IsDarkMode ? "Light Mode" : "Dark Mode")
            </button>
            <button class="claude-btn-secondary" @onclick="ToggleLanguage">
                <svg class="svg-icon" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="2" y1="12" x2="22" y2="12"></line>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
                @(IsArabic ? "English" : "العربية")
            </button>
        </div>
    </header>

    <!-- Navigation Tab Bar with Crisp SVG Icons -->
    <nav class="nav-tab-bar">
        <button class="nav-tab-button @(ActiveTab == 0 ? "active" : "")" @onclick="() => SetTab(0)">
            <svg class="svg-icon" viewBox="0 0 24 24">
                <line x1="18" y1="20" x2="18" y2="10"></line>
                <line x1="12" y1="20" x2="12" y2="4"></line>
                <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
            @(IsArabic ? "الإحصائيات" : "Dashboard")
        </button>
        <button class="nav-tab-button @(ActiveTab == 1 ? "active" : "")" @onclick="() => SetTab(1)">
            <svg class="svg-icon" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
            @(IsArabic ? "الإعدادات" : "Settings")
        </button>
        <button class="nav-tab-button @(ActiveTab == 2 ? "active" : "")" @onclick="() => SetTab(2)">
            <svg class="svg-icon" viewBox="0 0 24 24">
                <rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect>
                <line x1="6" y1="8" x2="6.01" y2="8"></line>
                <line x1="10" y1="8" x2="10.01" y2="8"></line>
                <line x1="14" y1="8" x2="14.01" y2="8"></line>
                <line x1="18" y1="8" x2="18.01" y2="8"></line>
                <line x1="6" y1="12" x2="6.01" y2="12"></line>
                <line x1="18" y1="12" x2="18.01" y2="12"></line>
                <line x1="7" y1="16" x2="17" y2="16"></line>
            </svg>
            @(IsArabic ? "الاختصارات" : "Hotkeys")
        </button>
        <button class="nav-tab-button @(ActiveTab == 3 ? "active" : "")" @onclick="() => SetTab(3)">
            <svg class="svg-icon" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            @(IsArabic ? "عن الأداة" : "About")
        </button>
    </nav>

    <!-- Main Content -->
    <main class="main-content">
        @if (ActiveTab == 0)
        {
            <!-- ==========================================
                 TAB 0: DASHBOARD & LIVE STATS
                 ========================================== -->
            <div class="section-header">
                <h2 class="serif-heading section-title">@(IsArabic ? "لوحة الإحصائيات والإنقاذ" : "Rescue Statistics")</h2>
                <p class="section-subtitle">@(IsArabic ? "سجل مباشر لعدد المرات والكلمات التي أنقذك فيها البرنامج مع الوقت المُوفَّر" : "Real-time metrics of corrected words and typing time saved in Windows")</p>
            </div>

            <div class="claude-card hero-stats-card">
                <div class="setting-title">
                    <svg class="svg-icon" style="color: var(--terracotta);" viewBox="0 0 24 24">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                    </svg>
                    @(IsArabic ? "إجمالي عدد مرات الإنقاذ حتى الآن" : "Total Typing Conversions")
                </div>
                <div class="serif-heading hero-number-display">@StatsService.TotalConversions.ToString("N0")</div>

                <div class="metrics-grid">
                    <div class="metric-tile">
                        <div class="metric-val">@StatsService.TotalCharacters.ToString("N0")</div>
                        <div class="metric-lbl">@(IsArabic ? "حرف تم تصحيحه" : "Chars Corrected")</div>
                    </div>
                    <div class="metric-tile">
                        <div class="metric-val">@StatsService.TotalWords.ToString("N0")</div>
                        <div class="metric-lbl">@(IsArabic ? "كلمة تم إنقاذها" : "Words Saved")</div>
                    </div>
                    <div class="metric-tile">
                        <div class="metric-val">@(IsArabic ? StatsService.GetTimeSavedDisplayArabic() : StatsService.GetTimeSavedDisplay())</div>
                        <div class="metric-lbl">@(IsArabic ? "وقت مُوفَّر" : "Time Saved")</div>
                    </div>
                </div>
            </div>

            <!-- Live Playground -->
            <div class="claude-card">
                <h3 class="serif-heading" style="font-size: 18px; margin: 0 0 6px 0; display: flex; align-items: center; gap: 8px;">
                    <svg class="svg-icon" style="color: var(--terracotta);" viewBox="0 0 24 24">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                    </svg>
                    @(IsArabic ? "منطقة التجربة الفورية المباشرة" : "Live Converter Playground")
                </h3>
                <p class="setting-desc" style="margin-bottom: 14px;">
                    @(IsArabic ? "اكتب أي نص ملخبط هنا واضغط الزر لاختبار التحويل والتقليب فوراً:" : "Type garbled English text below and click button to test instant bidirectional conversion:")
                </p>

                <div style="display: flex; gap: 10px; flex-direction: column;">
                    <input type="text" class="claude-input" @bind="PlaygroundText" />
                    <div>
                        <button class="claude-btn-primary" @onclick="TestConversion">
                            <svg class="svg-icon" viewBox="0 0 24 24">
                                <polyline points="23 4 23 10 17 10"></polyline>
                                <polyline points="1 20 1 14 7 14"></polyline>
                                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                            </svg>
                            @(IsArabic ? "شقلب النص الآن" : "Convert Text Now")
                        </button>
                    </div>
                </div>
            </div>
        }
        else if (ActiveTab == 1)
        {
            <!-- ==========================================
                 TAB 1: SETTINGS & PREFERENCES
                 ========================================== -->
            <div class="section-header">
                <h2 class="serif-heading section-title">@(IsArabic ? "إعدادات الأداة وسلوك التحويل" : "General Settings")</h2>
            </div>

            <div class="info-banner-card">
                <div class="banner-title">
                    <svg class="svg-icon" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="16" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                    @(IsArabic ? "طريقة الاستخدام الأساسية:" : "Default Usage Mode:")
                </div>
                <p class="banner-text">
                    @(IsArabic
                        ? "حدد أي كلمة أو جملة بالماوس في أي برنامج واضغط Alt+Q أو Ctrl+Q ليتم تحويلها واستبدالها في نفس المكان فوراً!"
                        : "Highlight any word or sentence in any app and press Alt+Q or Ctrl+Q to convert and replace in-place instantly!")
                </p>
            </div>

            <!-- Smart Detection Setting -->
            <div class="claude-card setting-row">
                <div class="setting-texts">
                    <div class="setting-title">
                        <svg class="svg-icon" style="color: var(--terracotta);" viewBox="0 0 24 24">
                            <path d="M12 2a4 4 0 0 0-4 4v1a4 4 0 0 0 8 0V6a4 4 0 0 0-4-4z"></path>
                            <path d="M6 10v1a6 6 0 0 0 12 0v-1"></path>
                            <line x1="12" y1="19" x2="12" y2="22"></line>
                        </svg>
                        @(IsArabic ? "الكشف الذكي للكلمات (Smart Vocabulary)" : "Smart Vocabulary Detection")
                    </div>
                    <p class="setting-desc">@(IsArabic ? "يحافظ على الكلمات الإنجليزية الصحيحة والروابط تلقائياً ويصحح فقط أخطاء الكتابة" : "Preserves real English words and URLs automatically while fixing typing mistakes")</p>
                </div>
                <label class="claude-toggle">
                    <input type="checkbox" @bind="Settings.SmartDetectionEnabled" @bind:after="OnSettingChanged" />
                    <span class="toggle-slider"></span>
                </label>
            </div>

            <!-- Auto-Convert Last Word Setting -->
            <div class="claude-card setting-row">
                <div class="setting-texts">
                    <div class="setting-title">
                        <svg class="svg-icon" style="color: var(--terracotta);" viewBox="0 0 24 24">
                            <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
                        </svg>
                        @(IsArabic ? "تحويل آخر كلمة تلقائياً بدون تحديد" : "Auto-Convert Last Word Without Selection")
                    </div>
                    <p class="setting-desc">@(IsArabic ? "عند نسيان تحديد النص بالماوس، يتم تحديد وتحويل آخر كلمة قبل المؤشر تلقائياً" : "Automatically selects and converts the word before the cursor when nothing is highlighted")</p>
                </div>
                <label class="claude-toggle">
                    <input type="checkbox" @bind="Settings.AutoConvertLastWord" @bind:after="OnSettingChanged" />
                    <span class="toggle-slider"></span>
                </label>
            </div>

            <!-- Show Conversion Toast Setting -->
            <div class="claude-card setting-row">
                <div class="setting-texts">
                    <div class="setting-title">
                        <svg class="svg-icon" style="color: var(--terracotta);" viewBox="0 0 24 24">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        </svg>
                        @(IsArabic ? "إظهار رسالة التحويل المنبثقة (Toast)" : "Show Conversion Toast Notification")
                    </div>
                    <p class="setting-desc">@(IsArabic ? "إظهار أو إخفاء الإشعار الخفيف في زاوية الشاشة بعد كل عملية تحويل" : "Show or hide the lightweight corner notification after each conversion")</p>
                </div>
                <label class="claude-toggle">
                    <input type="checkbox" @bind="Settings.ShowConversionToast" @bind:after="OnSettingChanged" />
                    <span class="toggle-slider"></span>
                </label>
            </div>

            <!-- App Exclusions & Custom Dictionary -->
            <div class="claude-card">
                <div class="setting-title" style="margin-bottom: 6px;">
                    <svg class="svg-icon" style="color: var(--terracotta);" viewBox="0 0 24 24">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                    @(IsArabic ? "استثناءات البرامج والكلمات الخاصة" : "App Exclusions & Custom Dictionary")
                </div>
                <p class="setting-desc" style="margin-bottom: 12px;">
                    @(IsArabic ? "برامج لا يعمل بداخلها الاختصار (مثل cmd أو powershell) وكلمات خاصة تبقى كما هي وسط العربي:" : "Apps where hotkeys are ignored (e.g., cmd, powershell) and custom words preserved inside Arabic text:")
                </p>

                <div style="margin-bottom: 14px;">
                    <div style="font-size: 13px; font-weight: 600; margin-bottom: 6px;">@(IsArabic ? "البرامج المستثناة (اسم العملية):" : "Excluded Apps (Process Name):")</div>
                    <div style="display: flex; gap: 8px;">
                        <input type="text" class="claude-input" style="flex: 1;" @bind="NewExcludedApp" @bind:event="oninput" placeholder="cmd, powershell, wt..." />
                        <button type="button" class="claude-btn-secondary" @onclick="AddExcludedApp">@(IsArabic ? "إضافة" : "Add")</button>
                    </div>
                    @if (Settings.ExcludedApps.Count > 0)
                    {
                        <div class="chip-list">
                            @foreach (var app in Settings.ExcludedApps)
                            {
                                <span class="chip-tag">
                                    @app
                                    <button type="button" class="chip-remove" @onclick="() => RemoveExcludedApp(app)">×</button>
                                </span>
                            }
                        </div>
                    }
                </div>

                <div>
                    <div style="font-size: 13px; font-weight: 600; margin-bottom: 6px;">@(IsArabic ? "كلمات خاصة لا تُحوَّل (القاموس الشخصي):" : "Custom Preserved Words:")</div>
                    <div style="display: flex; gap: 8px;">
                        <input type="text" class="claude-input" style="flex: 1;" @bind="NewCustomWord" @bind:event="oninput" placeholder="Munqith, Figma, API_Key..." />
                        <button type="button" class="claude-btn-secondary" @onclick="AddCustomWord">@(IsArabic ? "إضافة" : "Add")</button>
                    </div>
                    @if (Settings.CustomPreservedWords.Count > 0)
                    {
                        <div class="chip-list">
                            @foreach (var word in Settings.CustomPreservedWords)
                            {
                                <span class="chip-tag">
                                    @word
                                    <button type="button" class="chip-remove" @onclick="() => RemoveCustomWord(word)">×</button>
                                </span>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Start With Windows Setting -->
            <div class="claude-card setting-row">
                <div class="setting-texts">
                    <div class="setting-title">
                        <svg class="svg-icon" style="color: var(--terracotta);" viewBox="0 0 24 24">
                            <path d="M18.36 6.64a9 9 0 1 1-12.73 0"></path>
                            <line x1="12" y1="2" x2="12" y2="12"></line>
                        </svg>
                        @(IsArabic ? "التشغيل التلقائي مع فتح الجهاز" : "Start Automatically with Windows")
                    </div>
                    <p class="setting-desc">@(IsArabic ? "تشغيل أداة مُنقِذ تلقائياً في الخلفية عند بدء تشغيل نظام ويندوز" : "Launch Munqith automatically in the system tray when Windows starts")</p>
                </div>
                <label class="claude-toggle">
                    <input type="checkbox" @bind="Settings.StartWithWindows" @bind:after="OnStartupChanged" />
                    <span class="toggle-slider"></span>
                </label>
            </div>

            <!-- Administrator Elevation Card -->
            <div class="claude-card setting-row">
                <div class="setting-texts">
                    <div class="setting-title">
                        <svg class="svg-icon" style="color: var(--terracotta);" viewBox="0 0 24 24">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        </svg>
                        @(IsArabic ? "صلاحيات التشغيل (برامج المدير / Admin)" : "Elevated Permissions (Admin Apps)")
                    </div>
                    <p class="setting-desc">
                        @(TrayContext.IsRunningAsAdministrator
                            ? (IsArabic ? "الأداة تعمل حالياً بصلاحيات المدير وتدعم جميع البرامج بما فيها نوافذ Admin." : "Running as Administrator — works inside elevated apps as well.")
                            : (IsArabic ? "لو توقفت الأداة داخل برنامج يعمل كمسؤول (مثل Terminal Admin)، أعد تشغيلها كمسؤول." : "If an elevated app blocks conversion, restart Munqith as Administrator."))
                    </p>
                </div>
                @if (TrayContext.IsRunningAsAdministrator)
                {
                    <span class="hotkey-status-pill is-active">@(IsArabic ? "مسؤول (Admin)" : "Admin Active")</span>
                }
                else
                {
                    <button type="button" class="claude-btn-secondary" @onclick="RestartAsAdmin">
                        @(IsArabic ? "تشغيل كمسؤول" : "Run as Admin")
                    </button>
                }
            </div>

            <!-- Instant Save Card -->
            <div class="claude-card setting-row" style="background-color: var(--bg-secondary);">
                <div>
                    <button class="claude-btn-primary" @onclick="SaveAndApply">
                        <svg class="svg-icon" viewBox="0 0 24 24">
                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                            <polyline points="17 21 17 13 7 13 7 21"></polyline>
                            <polyline points="7 3 7 8 15 8"></polyline>
                        </svg>
                        @(IsArabic ? "حفظ وتطبيق" : "Save & Apply")
                    </button>
                </div>
                @if (ShowSaveToast)
                {
                    <div class="save-toast">
                        <svg class="svg-icon" viewBox="0 0 24 24">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        @(IsArabic ? "تم الحفظ والتطبيق بنجاح!" : "Saved & applied successfully!")
                    </div>
                }
            </div>
        }
        else if (ActiveTab == 2)
        {
            <!-- ==========================================
                 TAB 2: KEYBOARD SHORTCUTS
                 ========================================== -->
            <div class="section-header">
                <h2 class="serif-heading section-title">@(IsArabic ? "إدارة اختصارات الكيبورد" : "Keyboard Shortcuts")</h2>
                <p class="section-subtitle">@(IsArabic ? "الاختصاران الأساسيان المعتمدان لتحويل وشقلبة النصوص فورياً" : "The two primary core hotkeys for instant layout conversion")</p>
            </div>

            <div class="claude-card">
                @foreach (var hk in Settings.Hotkeys)
                {
                    <div class="hotkey-item">
                        <div>
                            <span class="hotkey-badge">@hk.DisplayName</span>
                            <span style="font-size: 13px; color: var(--text-secondary); margin-inline-start: 12px;">
                                @(hk.DisplayName.Contains("Alt+Q")
                                    ? (IsArabic ? "التحويل الأساسي السريع" : "Primary Instant Conversion")
                                    : hk.DisplayName.Contains("Ctrl+Q")
                                        ? (IsArabic ? "التحويل الثانوي الاحتياطي" : "Secondary Fallback Conversion")
                                        : (IsArabic ? "اختصار مخصص" : "Custom Shortcut"))
                            </span>
                        </div>
                        
                        <div class="hotkey-controls">
                            <span class="hotkey-status-pill @(hk.IsEnabled ? "is-active" : "is-inactive")">
                                @(hk.IsEnabled ? (IsArabic ? "مُفعّل" : "Active") : (IsArabic ? "معطّل" : "Disabled"))
                            </span>
                            <label class="claude-toggle" title="@(hk.IsEnabled ? (IsArabic ? "تعطيل الاختصار" : "Disable hotkey") : (IsArabic ? "تفعيل الاختصار" : "Enable hotkey"))">
                                <input type="checkbox" @bind="hk.IsEnabled" @bind:after="OnHotkeysChanged" />
                                <span class="toggle-slider"></span>
                            </label>
                            @if (Settings.Hotkeys.Count > 1)
                            {
                                <button type="button" class="hotkey-delete-btn" title="@(IsArabic ? "حذف الاختصار" : "Remove hotkey")" @onclick="() => RemoveHotkey(hk)">×</button>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Custom Hotkey Recorder -->
            <div class="claude-card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; gap: 10px; flex-wrap: wrap;">
                    <div>
                        <div class="setting-title">@(IsArabic ? "إضافة اختصار مخصص جديد" : "Add Custom Shortcut")</div>
                        <p class="setting-desc">@(IsArabic ? "اضغط داخل المربع ثم اضغط تركيبة المفاتيح المطلوبة (مثل Alt+W أو Ctrl+Shift+Z)" : "Click inside the box then press any key combination (e.g. Alt+W or Ctrl+Shift+Z)")</p>
                    </div>
                    <button type="button" class="claude-btn-secondary" @onclick="ResetDefaultHotkeys">
                        @(IsArabic ? "استعادة الافتراضي" : "Reset Defaults")
                    </button>
                </div>

                <div tabindex="0"
                     class="recorder-box @(IsRecordingHotkey ? "is-recording" : "")"
                     @onclick="StartRecordingHotkey"
                     @onblur="StopRecordingHotkey"
                     @onkeydown="OnRecorderKeyDown"
                     @onkeydown:preventDefault="true">
                    @if (IsRecordingHotkey)
                    {
                        <span style="font-weight: 600; color: var(--terracotta-active);">
                            @(IsArabic ? "🎙️ اضغط الاختصار الجديد الآن (مع Ctrl أو Alt أو Shift)..." : "🎙️ Press your new shortcut now (with Ctrl, Alt, or Shift)...")
                        </span>
                    }
                    else
                    {
                        <span style="color: var(--text-secondary); font-size: 14px;">
                            @(IsArabic ? "⌨️ انقر هنا لتسجيل اختصار كيبورد جديد" : "⌨️ Click here to record a new keyboard shortcut")
                        </span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(HotkeyRecorderMessage))
                {
                    <p style="font-size: 12.5px; color: var(--terracotta-active); margin: 10px 0 0 0;">@HotkeyRecorderMessage</p>
                }
            </div>
        }
        else if (ActiveTab == 3)
        {
            <div class="claude-card">
                <h3 class="serif-heading" style="font-size: 22px; color: var(--terracotta); margin: 0 0 12px 0; display: flex; align-items: center; gap: 8px;">
                    <svg class="svg-icon" style="width: 24px; height: 24px;" viewBox="0 0 24 24">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                    @(IsArabic ? "مُنقِذ — Munqith v1.0.2" : "Munqith v1.0.2")
                </h3>
                
                <p style="font-size: 14.5px; line-height: 1.7; margin: 0 0 14px 0;">
                    @(IsArabic
                        ? "أداة ويندوز ذكية وفائقة السرعة تعمل في الخلفية لتصحيح لغة الكتابة ثنائياً (عربي ↔ إنجليزي) تلقائياً في كافة البرامج والمتصفحات بضغطة اختصار واحدة، مع الحفاظ على الكلمات الإنجليزية والروابط ومحتوى الحافظة."
                        : "Fast, lightweight Windows utility running in the background to instantly auto-correct mistyped keyboard layouts bidirectionally (AR ↔ EN) across all Windows apps and browsers while preserving real English words, URLs, and your clipboard.")
                </p>

                <!-- Dedicated Free for Allah notice -->
                <div style="background-color: var(--terracotta-light); border: 1px solid var(--terracotta-border); color: var(--terracotta-active); padding: 14px 18px; border-radius: var(--radius-md); font-weight: 600; font-size: 14px; margin-bottom: 18px; line-height: 1.6;">
                    @(IsArabic 
                        ? "✨ هذه الأداة مجانية بالكامل ومفتوحة المصدر لوجه الله تعالى، ولا نرجو سوى الدعاء الصالح بظهر الغيب."
                        : "✨ This application is completely free and open-source for the sake of Allah. We only ask for your sincere prayers.")
                </div>

                <div style="background-color: var(--bg-secondary); padding: 14px 18px; border-radius: var(--radius-md); font-size: 13.5px; line-height: 1.85; margin-bottom: 20px;">
                    <div>• <strong>@(IsArabic ? "نظام التشغيل:" : "OS:")</strong> Windows 10 / Windows 11 (64-bit)</div>
                    <div>• <strong>@(IsArabic ? "التقنية:" : "Tech Stack:")</strong> C# .NET 8.0 LTS &amp; Blazor Hybrid</div>
                    <div>• <strong>@(IsArabic ? "خريطة الكيبورد:" : "Layout Engine:")</strong> @(IsArabic ? "تخطيط Windows Arabic 101 الكامل (Shift+Letter، التشكيل، الهمزات، وفك غموض حرف لا)" : "Full Windows Arabic 101 (Shift+Letter, diacritics, Hamza forms & Lam-Alef disambiguation)")</div>
                    <div>• <strong>@(IsArabic ? "محرك الاستجابة:" : "Input Engine:")</strong> @(IsArabic ? "Win32 Low-Level Hook (تجاهل الأحداث المحقونة) + SendInput + استعادة الحافظة التلقائية" : "Win32 Low-Level Hook (LLKHF_INJECTED safe) + SendInput + Auto Clipboard Restore")</div>
                    <div>• <strong>@(IsArabic ? "إحصائيات شريط المهام:" : "Tray Tracking:")</strong> @(IsArabic ? "حساب لحظي لعدد مرات الإنقاذ والوقت الفعلي الموفَّر في الخلفية" : "Live rescue counter & real time-saved tracking directly in the System Tray")</div>
                </div>

                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <button type="button" class="claude-btn-primary" @onclick="OpenGitHubRepo">
                        <svg class="svg-icon" viewBox="0 0 24 24">
                            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                        </svg>
                        GitHub Repository
                    </button>
                    <button type="button" class="claude-btn-secondary" @onclick="OpenGitHubReleases">
                        <svg class="svg-icon" viewBox="0 0 24 24">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                        @(IsArabic ? "صفحة الإصدارات والتحديثات" : "Releases & Updates")
                    </button>
                </div>
            </div>
        }
    </main>
</div>

@code {
    private AppSettings Settings => SettingsService.Settings;

    private int ActiveTab = 0;
    private bool IsDarkMode;
    private bool IsArabic;
    private string PlaygroundText = "hgpl]ggi , hga;v ggi";
    private bool ShowSaveToast = false;
    private string NewExcludedApp = string.Empty;
    private string NewCustomWord = string.Empty;
    private bool IsRecordingHotkey = false;
    private string HotkeyRecorderMessage = string.Empty;

    protected override void OnInitialized()
    {
        IsDarkMode = Settings.DarkMode;
        IsArabic = Settings.Language == "ar";
        Settings.StartWithWindows = StartupService.IsRegistered();

        // Ensure the 2 primary core hotkeys are always configured
        if (Settings.Hotkeys == null || Settings.Hotkeys.Count == 0)
        {
            Settings.Hotkeys = new List<HotkeyBinding>
            {
                new HotkeyBinding { ModifierKeysValue = 1, KeyValue = 0x51, IsEnabled = true }, // Alt + Q
                new HotkeyBinding { ModifierKeysValue = 2, KeyValue = 0x51, IsEnabled = true }  // Ctrl + Q
            };
            SettingsService.Save();
        }

        StatsService.StatsUpdated += OnStatsUpdated;
        TrayContext.DashboardActivated += OnDashboardActivated;
    }

    private void OnStatsUpdated()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnDashboardActivated()
    {
        _ = InvokeAsync(() =>
        {
            IsDarkMode = Settings.DarkMode;
            IsArabic = Settings.Language == "ar";
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        StatsService.StatsUpdated -= OnStatsUpdated;
        TrayContext.DashboardActivated -= OnDashboardActivated;
        TrayContext.SetHotkeyCapturePaused(false);
    }

    private void SetTab(int tabIndex)
    {
        StopRecordingHotkey();
        ActiveTab = tabIndex;
    }

    private void ToggleTheme()
    {
        IsDarkMode = !IsDarkMode;
        Settings.DarkMode = IsDarkMode;
        SettingsService.Save();
        TrayContext.CreateContextMenu();
    }

    private void ToggleLanguage()
    {
        IsArabic = !IsArabic;
        Settings.Language = IsArabic ? "ar" : "en";
        SettingsService.Save();
        TrayContext.CreateContextMenu();
    }

    private void OnSettingChanged()
    {
        SettingsService.Save();
    }

    private void OnStartupChanged()
    {
        StartupService.SetStartup(Settings.StartWithWindows);
        SettingsService.Save();
    }

    private void RestartAsAdmin()
    {
        TrayContext.RestartAsAdministrator();
    }

    private void OnHotkeysChanged()
    {
        SettingsService.Save();
        TrayContext.RegisterConfiguredHotkeys();
    }

    private void AddExcludedApp()
    {
        string value = NewExcludedApp.Trim();
        if (value.EndsWith(".exe", StringComparison.OrdinalIgnoreCase)) value = value[..^4];
        if (!string.IsNullOrEmpty(value) && !Settings.ExcludedApps.Contains(value, StringComparer.OrdinalIgnoreCase))
        {
            Settings.ExcludedApps.Add(value);
            SettingsService.Save();
        }
        NewExcludedApp = string.Empty;
    }

    private void RemoveExcludedApp(string app)
    {
        Settings.ExcludedApps.Remove(app);
        SettingsService.Save();
    }

    private void AddCustomWord()
    {
        string value = NewCustomWord.Trim();
        if (!string.IsNullOrEmpty(value) && !Settings.CustomPreservedWords.Contains(value, StringComparer.OrdinalIgnoreCase))
        {
            Settings.CustomPreservedWords.Add(value);
            SettingsService.Save();
        }
        NewCustomWord = string.Empty;
    }

    private void RemoveCustomWord(string word)
    {
        Settings.CustomPreservedWords.Remove(word);
        SettingsService.Save();
    }

    private void RemoveHotkey(HotkeyBinding binding)
    {
        if (Settings.Hotkeys.Count <= 1) return;
        Settings.Hotkeys.Remove(binding);
        OnHotkeysChanged();
    }

    private void ResetDefaultHotkeys()
    {
        Settings.Hotkeys = new List<HotkeyBinding>
        {
            new HotkeyBinding { ModifierKeysValue = 2, KeyValue = 0x51, IsEnabled = true },
            new HotkeyBinding { ModifierKeysValue = 1, KeyValue = 0x51, IsEnabled = true }
        };
        HotkeyRecorderMessage = IsArabic ? "تمت استعادة الاختصارات الافتراضية." : "Default hotkeys restored.";
        OnHotkeysChanged();
    }

    private void StartRecordingHotkey()
    {
        IsRecordingHotkey = true;
        HotkeyRecorderMessage = string.Empty;
        TrayContext.SetHotkeyCapturePaused(true);
    }

    private void StopRecordingHotkey()
    {
        if (IsRecordingHotkey)
        {
            IsRecordingHotkey = false;
            TrayContext.SetHotkeyCapturePaused(false);
        }
    }

    private void OnRecorderKeyDown(KeyboardEventArgs e)
    {
        if (!IsRecordingHotkey) return;

        if (e.Key is "Control" or "Alt" or "Shift" or "Meta") return;

        int modifiers = 0;
        if (e.AltKey) modifiers |= 1;
        if (e.CtrlKey) modifiers |= 2;
        if (e.ShiftKey) modifiers |= 4;

        if (modifiers == 0)
        {
            HotkeyRecorderMessage = IsArabic
                ? "يجب اختيار مفتاح معدل واحد على الأقل (Ctrl أو Alt أو Shift)."
                : "Please include at least one modifier key (Ctrl, Alt, or Shift).";
            return;
        }

        int vk = MapKeyboardEventToVirtualKey(e);
        if (vk == 0)
        {
            HotkeyRecorderMessage = IsArabic ? "هذا المفتاح غير مدعوم للاختصار." : "This key is not supported as a shortcut.";
            return;
        }

        bool exists = Settings.Hotkeys.Any(h => h.ModifierKeysValue == modifiers && h.KeyValue == vk);
        if (!exists)
        {
            var binding = new HotkeyBinding { ModifierKeysValue = modifiers, KeyValue = vk, IsEnabled = true };
            Settings.Hotkeys.Add(binding);
            OnHotkeysChanged();
            HotkeyRecorderMessage = IsArabic
                ? $"تمت إضافة الاختصار: {binding.DisplayName}"
                : $"Added shortcut: {binding.DisplayName}";
        }
        else
        {
            HotkeyRecorderMessage = IsArabic ? "هذا الاختصار مسجل بالفعل." : "This shortcut is already registered.";
        }

        StopRecordingHotkey();
    }

    private static int MapKeyboardEventToVirtualKey(KeyboardEventArgs e)
    {
        if (!string.IsNullOrEmpty(e.Code))
        {
            if (e.Code.StartsWith("Key") && e.Code.Length == 4 && char.IsLetter(e.Code[3]))
                return char.ToUpperInvariant(e.Code[3]);
            if (e.Code.StartsWith("Digit") && e.Code.Length == 6 && char.IsDigit(e.Code[5]))
                return e.Code[5];
            if (e.Code.StartsWith("F") && int.TryParse(e.Code[1..], out int fn) && fn is >= 1 and <= 12)
                return 0x70 + (fn - 1);
            if (e.Code == "Space") return 0x20;
        }

        if (!string.IsNullOrEmpty(e.Key) && e.Key.Length == 1 && char.IsLetterOrDigit(e.Key[0]))
            return char.ToUpperInvariant(e.Key[0]);

        return 0;
    }

    private void TestConversion()
    {
        if (!string.IsNullOrEmpty(PlaygroundText))
        {
            PlaygroundText = Settings.SmartDetectionEnabled
                ? SmartDetector.SmartConvert(PlaygroundText, Settings.CustomPreservedWords)
                : LayoutConverter.Convert(PlaygroundText);
        }
    }

    private async Task SaveAndApply()
    {
        StartupService.SetStartup(Settings.StartWithWindows);
        SettingsService.Save();
        TrayContext.RegisterConfiguredHotkeys();
        TrayContext.CreateContextMenu();

        ShowSaveToast = true;
        StateHasChanged();

        await Task.Delay(2500);
        ShowSaveToast = false;
        StateHasChanged();
    }

    private void OpenGitHubRepo() => OpenExternalUrl("https://github.com/M7MD-ox/Munqith");

    private void OpenGitHubReleases() => OpenExternalUrl("https://github.com/M7MD-ox/Munqith/releases/latest");

    private static void OpenExternalUrl(string url)
    {
        try
        {
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(url)
            {
                UseShellExecute = true
            });
        }
        catch { }
    }
}
